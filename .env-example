# Drumbeat configuration (.env). Copy to .env and fill in real values.
# Every variable documented here is read via python-dotenv at startup (§14).
# start_all.sh sets the port-derived vars (REDIS_URL, DJANGO_PORT, VITE_PORT)
# at runtime, so you normally do NOT set those by hand.

# --- Required: default LLM config (fail loud at startup if any is missing) ---
# All five DEFAULT_LLM_* are required. Each call-point falls back to these.
DEFAULT_LLM_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=sk-your-key-here
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TOKENS=1500
DEFAULT_LLM_TEMP=0.2

# --- Required: Tavily search ---
TAVILY_API_KEY=tvly-your-key-here

# --- Required at runtime (set by start_all.sh; no localhost fallback) ---
# REDIS_URL=redis://localhost:6379/0

# --- Optional: per-call-point LLM overrides -------------------------------
# There are SIX call-points. Each may override any of the five LLM settings;
# any omitted setting falls back to the matching DEFAULT_LLM_* value above. So
# you can, e.g., give SENTIMENT a stronger model while the rest use the default.
# Every variable is listed below (all commented out = "use DEFAULT_LLM_*").

# IDENTITY — resolve the company's official domain (name-only input).
# IDENTITY_LLM_URL=
# IDENTITY_LLM_API_KEY=
# IDENTITY_LLM_MODEL=
# IDENTITY_LLM_TOKENS=
# IDENTITY_LLM_TEMP=

# QUERY_PLANNER — turn company + category into third-party search queries.
# QUERY_PLANNER_LLM_URL=
# QUERY_PLANNER_LLM_API_KEY=
# QUERY_PLANNER_LLM_MODEL=
# QUERY_PLANNER_LLM_TOKENS=
# QUERY_PLANNER_LLM_TEMP=

# CURATOR — filter/exclude/dedupe candidates; may request more searches.
# CURATOR_LLM_URL=
# CURATOR_LLM_API_KEY=
# CURATOR_LLM_MODEL=
# CURATOR_LLM_TOKENS=
# CURATOR_LLM_TEMP=

# CATEGORY_SUMMARY — one summary paragraph per category.
# CATEGORY_SUMMARY_LLM_URL=
# CATEGORY_SUMMARY_LLM_API_KEY=
# CATEGORY_SUMMARY_LLM_MODEL=
# CATEGORY_SUMMARY_LLM_TOKENS=
# CATEGORY_SUMMARY_LLM_TEMP=

# REPORT — one run-level executive overview.
# REPORT_LLM_URL=
# REPORT_LLM_API_KEY=
# REPORT_LLM_MODEL=
# REPORT_LLM_TOKENS=
# REPORT_LLM_TEMP=

# SENTIMENT — per-item sentiment score + summary for the trend graph.
# (Most judgment-heavy call-point; a good candidate for a stronger model.)
# SENTIMENT_LLM_URL=
# SENTIMENT_LLM_API_KEY=
# SENTIMENT_LLM_MODEL=
# SENTIMENT_LLM_TOKENS=
# SENTIMENT_LLM_TEMP=

# --- Optional tunables (defaults shown) -----------------------------------
# Curator loop bounds (§5.6)
# CURATOR_MAX_ITERATIONS=3
# CURATOR_MAX_SEARCHES=5

# Reaper / run duration (§5.5)
# RUN_MAX_DURATION_SECONDS=600
# REAPER_INTERVAL_SECONDS=60

# Celery subtask time limits (§17.1; soft < hard)
# SUBTASK_SOFT_LIMIT=180
# SUBTASK_HARD_LIMIT=210
# WORKER_CONCURRENCY=4

# Volume / prompt-size caps (§6.2)
# QUERY_PLANNER_MAX_QUERIES=3
# TAVILY_RESULTS_PER_SEARCH=10
# MAX_CANDIDATES_PER_CATEGORY=40
# MAX_ITEMS_PER_CATEGORY=20
# MAX_SNIPPET_CHARS=300
# REPORT_MAX_ITEMS_TOTAL=60
# REPORT_MAX_ITEM_SNIPPET_CHARS=200
# REPORT_MAX_CHARS=4000
# SUMMARY_MAX_CHARS=1200

# Sentiment scoring (per-item; see plans/SENTIMENT-DESIGN.md)
# SENTIMENT_ENABLED=1
# SENTIMENT_MAX_ITEMS=10   # per category; kept below the subtask soft limit
# SENTIMENT_MAX_CONTENT_CHARS=1500  # page text fed to the scorer (incl. body)
# SENTIMENT_SUMMARY_MAX_CHARS=400   # cap on the sentiment-aware item summary

# API validation (§11)
# MAX_INPUT_LENGTH=2000
# RUN_LIST_PAGE_SIZE=50

# LLM JSON mode: ask the provider for a valid JSON object on the structured
# call-points (OpenAI/OpenRouter support this). Set to 0 if your provider
# rejects response_format.
# LLM_JSON_MODE=1

# On malformed structured output, re-prompt the model with the validation error
# this many times before falling back non-fatally (§6.1). 0 disables retries.
# LLM_MAX_RETRIES=2

# LLM call logging (§7)
# LLM_LOG_DIR=logs
# LLM_LOG_MAX_BYTES=10485760
# LLM_LOG_BACKUP_COUNT=5

# --- Internal (do NOT set in .env) ----------------------------------------
# DRUMBEAT_SKIP_CONFIG_CHECK — test/dev-only switch that BYPASSES the fail-loud
# required-config validation. It is set to 1 by pytest.ini for the test suite;
# setting it in .env would defeat the startup config check. Listed here only
# for completeness — leave it unset.
#
# DJANGO_PORT / VITE_PORT / REDIS_URL are chosen and exported by start_all.sh at
# runtime (see the top of this file); do not set them by hand.
